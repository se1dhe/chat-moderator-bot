# --- Telegram ---
# Get a fresh token from @BotFather. NEVER commit the real value.
BOT_TOKEN=put-your-bot-token-here
# Comma-separated Telegram user IDs of bot super-admins (owners).
OWNER_IDS=

# --- Database (Postgres) ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=redqueen
POSTGRES_USER=redqueen
POSTGRES_PASSWORD=change-me
# Optional: full DSN overrides the parts above.
# DATABASE_URL=postgresql+asyncpg://redqueen:change-me@localhost:5432/redqueen

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- AI (Ollama / Qwen) ---
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:4b
# AI moderation is optional; bot works without it (rule-based fallback).
# Vision model for multimodal anti-scam (e.g. qwen2.5vl:7b, llava:7b). Empty = disabled.
OLLAMA_VISION_MODEL=
AI_ENABLED=false
# Max concurrent Ollama classification calls across all chats.
AI_MAX_CONCURRENCY=2
# Pull OLLAMA_MODEL automatically on startup if missing (backend self-provisioning).
OLLAMA_AUTO_PULL=true
# Voice anti-scam (ASR) via faster-whisper — needs `uv sync --extra voice`. Empty = off.
WHISPER_MODEL=
WHISPER_DEVICE=cpu
WHISPER_COMPUTE=int8

# --- Runtime ---
# polling (dev) or webhook (prod / ngrok)
RUN_MODE=polling
# Public base URL for webhook mode (e.g. your ngrok domain), no trailing slash.
WEBHOOK_BASE_URL=
WEBHOOK_PATH=/webhook
WEBHOOK_HOST=0.0.0.0
WEBHOOK_PORT=8080
# Secret token Telegram sends back to verify webhook calls.
WEBHOOK_SECRET=

# --- Mini App / API ---
# In polling mode the API + Mini App listen here; in webhook mode they share the
# webhook host/port instead. WEBAPP_DIST points at the built frontend (webapp/dist).
API_HOST=0.0.0.0
API_PORT=8080
WEBAPP_DIST=webapp/dist
# Public HTTPS URL of the served Mini App (e.g. https://yourdomain/app or an ngrok
# https URL). When set, the bot wires the chat menu button + /panel to it.
WEBAPP_URL=

DEFAULT_LANG=en
LOG_LEVEL=INFO

# --- Dev HTTPS tunnel (ngrok) ---
# For `docker compose --profile tunnel up ngrok`. Get an authtoken at
# https://dashboard.ngrok.com; NGROK_DOMAIN is your reserved free domain.
NGROK_AUTHTOKEN=
NGROK_DOMAIN=
